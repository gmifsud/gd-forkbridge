<Project>
  <!--
    Keep ISL fork-owned replacements outside the upstream-owned source paths.
    The original files remain available for upstream merges, but are removed
    from compilation for the specific projects below.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'QiSL.Platform.Core'">
    <Compile Remove="Web/WebContentFolderHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ISL.Overrides/Platform/Web/WebContentFolderHelper.cs"
             Link="Web/WebContentFolderHelper.cs" />
  </ItemGroup>

  <!--
    ModuleTypes = upstream enum + ISL fork modules, composed at build time.
    Upstream owns Enums/ModuleTypes.cs (never edited here); the fork owns only its delta in
    ISL.Overrides/ModuleTypes.Fork.props. Upstream additions flow in automatically on import.
    Fork members carry fixed values (1000+) so upstream additions never shift them: ISL modules consume
    the enum through lib/*.dll, and enum values are compiled into callers as numbers.
  -->
  <Import Project="$(MSBuildThisFileDirectory)ISL.Overrides/ModuleTypes.Fork.props" />

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'QiSL.Platform.SharedKernel.Domain' or '$(MSBuildProjectName)' == 'QiSL.App.BaseTemplate.Core.Shared'">
    <IslComposeModuleTypes>true</IslComposeModuleTypes>
    <IslModuleTypesSource>$(MSBuildProjectDirectory)/Enums/ModuleTypes.cs</IslModuleTypesSource>
    <IslModuleTypesComposed>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)ModuleTypes.Composed.g.cs</IslModuleTypesComposed>
  </PropertyGroup>

  <ItemGroup Condition="'$(IslComposeModuleTypes)' == 'true'">
    <Compile Remove="Enums/ModuleTypes.cs" />
    <None Include="Enums/ModuleTypes.cs" />
  </ItemGroup>

  <UsingTask TaskName="IslComposeEnum" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <EnumName ParameterType="System.String" Required="true" />
      <Members ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var src = File.ReadAllText(SourceFile);
        var m = Regex.Match(src, @"\benum\s+" + Regex.Escape(EnumName) + @"\b[^{]*\{(?<body>[^}]*)\}");
        if (!m.Success) { Log.LogError("IslComposeEnum: enum {0} not found in {1}", EnumName, SourceFile); return false; }
        var body = m.Groups["body"];
        var code = Regex.Replace(body.Value, @"/\*.*?\*/|//[^\r\n]*", "", RegexOptions.Singleline);
        var existing = new HashSet<string>(code.Split(',').Select(s => s.Split('=')[0].Trim()).Where(s => s.Length > 0), StringComparer.Ordinal);
        var items = (Members ?? new Microsoft.Build.Framework.ITaskItem[0]).Where(i => i.ItemSpec.Trim().Length > 0).ToList();
        var fork = new List<KeyValuePair<string, int>>();
        foreach (var i in items) {
          var n = i.ItemSpec.Trim(); var raw = i.GetMetadata("Value"); int v;
          if (!Regex.IsMatch(n, @"^[A-Za-z_][A-Za-z0-9_]*$")) { Log.LogError("IslComposeEnum: '{0}' is not a valid enum member name (ISL.Overrides/ModuleTypes.Fork.props)", n); continue; }
          if (!int.TryParse(raw, out v) || v < 1000) { Log.LogError("IslComposeEnum: {0} needs a fixed Value of 1000 or more (got '{1}')", n, raw); continue; }
          if (fork.Any(f => f.Key == n)) { Log.LogError("IslComposeEnum: {0} is listed twice", n); continue; }
          if (fork.Any(f => f.Value == v)) { Log.LogError("IslComposeEnum: Value {0} of {1} is already used by {2}", v, n, fork.First(f => f.Value == v).Key); continue; }
          fork.Add(new KeyValuePair<string, int>(n, v));
        }
        if (Log.HasLoggedErrors) return false;
        foreach (var dup in fork.Where(f => existing.Contains(f.Key))) { Log.LogWarning("IslComposeEnum: {0}.{1} now exists upstream with upstream's value (was {2}). Remove it from ISL.Overrides/ModuleTypes.Fork.props and rebuild every lib/ DLL that uses it.", EnumName, dup.Key, dup.Value); }
        var add = fork.Where(f => !existing.Contains(f.Key)).ToList();
        var nl = src.Contains("\r\n") ? "\r\n" : "\n";
        var sb = new System.Text.StringBuilder();
        sb.Append("// <auto-generated>").Append(nl)
          .Append("//   Composed by IslComposeModuleTypes (QiSL.Fabric/Directory.Build.targets).").Append(nl)
          .Append("//   Upstream: ").Append(Path.GetFileName(SourceFile)).Append(" + fork: ISL.Overrides/ModuleTypes.Fork.props. Do not edit.").Append(nl)
          .Append("// </auto-generated>").Append(nl);
        var end = body.Index + body.Value.TrimEnd().Length;
        sb.Append(src, 0, end);
        if (add.Count > 0) {
          var needsComma = code.Trim().Length > 0 && !code.TrimEnd().EndsWith(",");
          if (needsComma) sb.Append(nl).Append("        ,");
          sb.Append(nl).Append("        // ISL fork modules");
          foreach (var f in add) sb.Append(nl).Append("        ").Append(f.Key).Append(" = ").Append(f.Value).Append(',');
        }
        sb.Append(src, end, src.Length - end);
        var result = sb.ToString();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != result) File.WriteAllText(OutputFile, result);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- BeforeTargets=CoreCompile also runs in IDE design-time builds, so IntelliSense sees the members. -->
  <Target Name="IslComposeModuleTypes" Condition="'$(IslComposeModuleTypes)' == 'true'" BeforeTargets="CoreCompile">
    <IslComposeEnum SourceFile="$(IslModuleTypesSource)" EnumName="ModuleTypes" Members="@(IslModuleType)" OutputFile="$(IslModuleTypesComposed)" />
    <ItemGroup>
      <Compile Include="$(IslModuleTypesComposed)" />
      <FileWrites Include="$(IslModuleTypesComposed)" />
    </ItemGroup>
  </Target>
</Project>
