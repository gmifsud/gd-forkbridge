+        partial void SeedForkWorkflows(
+            IUnitOfWorkManager unitOfWorkManager,
+            ILocalizationManager localizationManager,
+            BaseTemplateDbContext baseTemplateDbContext,
+            WFDbContext context,
+            int? tenantId);
     }
 }
